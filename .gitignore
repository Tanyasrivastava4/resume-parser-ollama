# .gitignore
#
# Excludes local environments, generated/runtime data, and editor/OS
# clutter from version control. Folder placeholders (.gitkeep) are kept so
# the empty directory structure itself still gets committed.

# Virtual environments
.venv/
venv/
env/

# Python bytecode / caches
__pycache__/
*.pyc
*.pyo

# Environment / secrets
.env
.env.*

# Runtime data — resumes, generated JSON, and logs are inputs/outputs of
# runs, not source code, so they shouldn't be committed.
input/*
!input/.gitkeep
!input/resumes/
input/resumes/*
!input/resumes/.gitkeep
output/*
!output/.gitkeep
logs/*
!logs/.gitkeep

# Benchmark results/summary are regenerated by each run of
# benchmark/run_benchmark.py, not source code.
benchmark/results.csv
benchmark/summary.json

# Editor / OS
.vscode/
.idea/
.DS_Store

# Test / coverage artifacts
.pytest_cache/
.coverage
htmlcov/

# Office temporary lock files (remediation R-12, 2026-10-17): a tracked
# docs/~$Review_resume.xlsx lock file was removed from history-going-forward.
~$*
.~lock.*#
